# Port de l'API sur la machine (8000 dans le conteneur)
BACKEND_PORT=8000

# Jeton personnel Lichess, sans aucune permission cochée :
# https://lichess.org/account/oauth/token
LICHESS_TOKEN=

# Profondeur de calcul de Stockfish (plus haut = plus précis mais plus lent)
STOCKFISH_DEPTH=15

# Clé API Gemini (https://aistudio.google.com/apikey), pour la rédaction des explications
GOOGLE_API_KEY=

# Clé API YouTube Data v3 (console.cloud.google.com, API « YouTube Data API v3 » activée)
YOUTUBE_API_KEY=
